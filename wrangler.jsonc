{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "consultoriapatrimonialbe",
  "main": "src/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": false,
    "not_found_handling": "single-page-application"
  }
}
